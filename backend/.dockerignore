# .dockerignore for LabTrack Backend Repository

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.swp
*.log

# Git & Version Control
.git/
.gitignore
.gitattributes
.github/

# IDE & Editor Configurations
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# .NET Build Output & Artifacts
bin/
obj/
publish/
out/
*.useros
*.DotSettings
*.nupkg

# Python Environments & Artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# Node.js & E2E Testing Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
playwright-report/
test-results/

# Environment Files & Local Secrets
.env
.env.local
.env.development
.env.staging
*.pem
*.pfx
*.crt
*.key

# Temporary Backup & Restore Staging Files
*.dump
*.dump.enc
temp/
tmp/