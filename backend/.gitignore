# LabTrack Enterprise Solution Master GitIgnore

# ==============================================================================
# 1. Operating System & System-Generated Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.temp
*.swp
*.bak
*.log

# ==============================================================================
# 2. IDE, Editors & Development Environment Configurations
# ==============================================================================
# Visual Studio / Roslyn / JetBrains
.vs/
.idea/
*.user
*.useros
*.suo
*.sln.docstates
*.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Rider / Omnisharp
.idea/
*.sln.DotSettings

# ==============================================================================
# 3. .NET 8 / C# Build Outputs, Artifacts & Dependencies
# ==============================================================================
bin/
obj/
publish/
out/
[Bb]in/
[Oo]bj/
[Pp]ublish/
[Oo]ut/
*.nupkg
*.snupkg
*.user-libraries
*.project.lock.json
project.fragment.lock.json
artifacts/

# Entity Framework Core Generated Artifacts
*.designer.cs
*.efmigrations.sql

# ==============================================================================
# 4. Python AI Engine, Virtual Environments & Caches
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# ==============================================================================
# 5. Node.js, Frontend & Playwright E2E Testing Artifacts
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
playwright-report/
blob-report/
test-results/
.playwright/

# ==============================================================================
# 6. Database Dumps, Backups & Temporary Staging Files
# ==============================================================================
*.dump
*.dump.enc
*.sql.bak
temp/
tmp/
/backups/
/var/backups/

# ==============================================================================
# 7. Environment Variables, Certificates & Local Secrets
# ==============================================================================
.env
.env.local
.env.development
.env.staging
.env.production
!.env.example

# Cryptographic Keys & Certificates
*.pem
*.pfx
*.crt
*.key
*.cer
*.p12
*.kdbx