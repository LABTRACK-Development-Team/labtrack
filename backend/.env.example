# ==============================================================================
# LabTrack Enterprise Infrastructure Environment Configuration Template
# Kopyahin ang file na ito bilang '.env' para sa local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global & Environment Settings
# ------------------------------------------------------------------------------
LABTRACK_ENV=Development
ASPNETCORE_ENVIRONMENT=Development
PYTHON_ENV=development
LOG_LEVEL=Information

# Host Ports
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443
API_PORT=8080
AI_ENGINE_PORT=8000
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Multi-Tenant Database
# ------------------------------------------------------------------------------
POSTGRES_DB=labtrack_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sven292005
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection Strings
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=labtrack_db;Username=postgres;Password=sven292005;SearchPath=public,auth,inventory,scheduling,telemetry,maintenance,financial,ai,audit

# Connection Pool & Timeout Controls
DB_POOL_MAX_SIZE=100
DB_COMMAND_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 3. .NET 8 API Gateway & Authentication
# ------------------------------------------------------------------------------
# Cryptographic Key (Kailangang hindi bababa sa 32 characters)
JWT_SECRET_KEY=YourSuperSecretKeyThatIsAtLeast32BytesLongForHS256Algorithm!
JWT_ISSUER=LabTrack.Api
JWT_AUDIENCE=LabTrack.Client
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Multi-Factor Authentication (MFA / TOTP)
MFA_ISSUER_NAME=LabTrack-Enterprise

# Account Lockout & Security Policies
SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=5
SECURITY_ACCOUNT_LOCKOUT_MINUTES=15

# CORS Settings (Mgalistahan ng pinapayagang origins)
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080

# ------------------------------------------------------------------------------
# 4. Python FastAPI AI & pgvector Engine
# ------------------------------------------------------------------------------
AI_ENGINE_HOST=ai-engine
AI_ENGINE_PORT=8000
AI_ENGINE_TIMEOUT_SECONDS=120

# Vector Embeddings & Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384
PGVECTOR_COLLECTION_NAME=labtrack_knowledge_base

# LLM Integration Keys
OPENAI_API_KEY=sk-proj-placeholder-key-replace-in-production

# ------------------------------------------------------------------------------
# 5. SignalR Real-Time Telemetry & WebSockets
# ------------------------------------------------------------------------------
SIGNALR_HEARTBEAT_INTERVAL_SECONDS=15
SIGNALR_CLIENT_TIMEOUT_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# 6. Operational Scripts & Disaster Recovery Backup
# ------------------------------------------------------------------------------
# AES-256-CBC Encryption Key para sa Automated Backup Archives (backup.ps1 / restore.ps1)
BACKUP_BACKEND_ENCRYPTION_KEY=ReplaceWithStrongBackupEncryptionKey32Chars!
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_DIR=/var/backups/labtrack

# ------------------------------------------------------------------------------
# 7. Reverse Proxy & Rate Limiting (Nginx)
# ------------------------------------------------------------------------------
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_SECOND=50